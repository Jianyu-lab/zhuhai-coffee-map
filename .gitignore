# ── 密钥（绝不入库）─────────────────────────────
# scripts/.env 里有高德服务端 Key，泄露会被盗刷配额
.env
scripts/.env

# ── 采集缓存 ───────────────────────────────────
# 1966 个网格文件，重跑只补缺失格，用 fetch.py 可随时重建
data/cache/

# ── 原始采集快照 ───────────────────────────────
# 8MB 高德 API 原始返回，fetch.py 可重新采集。
# 仓库里只留清洗后的 data/coffee_clean.json，CI 用它跑 build_web.py 就够
data/raw_*.json

# ── 构建产物：高德 Key 注入 ────────────────────
# 由 scripts/gen_config.py 生成，真值来自 scripts/.env 或 GitHub Secrets
web/config.js

# ── 过程产物 ───────────────────────────────────
# 批量删数据前的手工备份；原始版本在 git 历史里，这里只是本地保险
data/backup/
# Playwright 验证截图
shots/
# README 用的过程截图
docs-detail.png
docs-heat.png
docs-screenshot.png
